# ============================================================
# Caporales San Gabriel — Variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# ============================================================

# ---------- Supabase ----------
# URL de tu proyecto (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública anon (Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Clave service_role (Dashboard → Settings → API → service_role) ¡NUNCA exponer al cliente!
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------- Email con Resend ----------
# API Key de https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Email verificado en Resend como remitente
RESEND_FROM_EMAIL=noreply@caporalessangabriel.cl
# Email del super administrador (recibe solicitudes de registro)
SUPER_ADMIN_EMAIL=admin@caporalessangabriel.cl

# ---------- App ----------
# URL pública de la app (en producción: https://tu-dominio.cl)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Caporales San Gabriel

# ---------- Seguridad ----------
# Clave secreta larga y aleatoria para firmar tokens de aprobación (HMAC)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_SECRET=una-clave-secreta-larga-aleatoria-para-firmar-tokens

# ---------- Rate Limiting (Upstash Redis) — OPCIONAL ----------
# Si no se configuran, se usa un limitador en memoria (solo desarrollo).
# Crea una DB gratis en https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token-de-upstash